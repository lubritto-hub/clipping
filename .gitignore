# design-sync working directories
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# design-system build + local visual verification
design-system/node_modules/
design-system/dist/
design-system/.preview/

# ...except the art pipeline, which is source: the deck cannot be rebuilt
# without it, and the compositions are the design work.
!design-system/.preview/
design-system/.preview/*
!design-system/.preview/art.mjs
!design-system/.preview/materials.py
!design-system/.preview/plates.py
!design-system/.preview/bg.mjs
!design-system/.preview/markshot.mjs
!design-system/.preview/demo.tsx
!design-system/.preview/themecheck.mjs
!design-system/.preview/art-pep.mjs
!design-system/.preview/devices.mjs
!design-system/.preview/materials-coco.py
!design-system/.preview/icons-coco.mjs
!design-system/.preview/art-prop.mjs
!design-system/.preview/gif-coco.py

# As quatro fotografias da proposta vieram do arquivo do próprio cliente e não
# são geráveis a partir de nada aqui: sem elas o baralho não reconstrói. Os SVG
# irmãos delas continuam de fora — esses saem de materials*.py a qualquer hora.
# É preciso destravar img/ para poder descer nela, e voltar a travar o conteúdo:
# o git não reinclui um arquivo cujo diretório-pai está excluído.
!design-system/.preview/img/
design-system/.preview/img/*
!design-system/.preview/img/foto/

# Saídas do renderizador de QA
qa*.html
